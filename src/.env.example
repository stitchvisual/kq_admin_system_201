# ============================================
# NON-SECRET ENVIRONMENT VARIABLES
# ============================================
# This file contains configuration that is not sensitive
# and can be committed to version control.
#
# For secrets (API keys, DSNs, passwords), use .env.example.secrets
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Admin Email (optional, defaults to first user)
ADMIN_EMAIL=admin@example.com

# Business Details (for PDF invoices)
# These are business contact information, not API secrets
NEXT_PUBLIC_BUSINESS_NAME=Your Business Name
NEXT_PUBLIC_BUSINESS_ABN=00 000 000 000
NEXT_PUBLIC_BUSINESS_EMAIL=contact@yourbusiness.com.au
NEXT_PUBLIC_BUSINESS_ADDRESS=Your Business Address
NEXT_PUBLIC_BUSINESS_BANK_NAME=Your Bank Name
NEXT_PUBLIC_BUSINESS_BSB=000-000
NEXT_PUBLIC_BUSINESS_ACCOUNT_NUMBER=00000000
NEXT_PUBLIC_BUSINESS_ACCOUNT_NAME=Account Name
NEXT_PUBLIC_NDIS_REGISTRATION_NUMBER=12345678

# Travel Rate (per km in AUD)
NEXT_PUBLIC_TRAVEL_RATE=0.97

# Sentry Environment
# Environment name: development, staging, or production
SENTRY_ENVIRONMENT=development

# Release version (optional, for source map mapping)
SENTRY_RELEASE=1.0.0

# Application URL (for redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Secrets (see .env.example.secrets) ---
# DATABASE_URL: For Vercel, use Supabase **Transaction pooler** (port 6543), not direct 5432.
# Dashboard: Project Settings → Database → Connection string → Transaction / "Pooler"