# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
# This file contains all environment variables needed to run the KQ Portal.
# Copy this file to .env.local and fill in your actual values.
#
# Required Variables: Must be set for the application to work
# Optional Variables: Have defaults or can be left empty
# ============================================================================

# Supabase (REQUIRED)
# Your Supabase project URL - found in Supabase dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Connection (REQUIRED)
# PostgreSQL connection string - typically provided by Supabase
# If using Supabase PostgreSQL, this is automatically derived from your project
DATABASE_URL="postgresql://postgres.hrwmorfduamlcvtlrtvq:maH6LYaV8P8hJkxd@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Authentication (REQUIRED)
# Email address for the admin user - used for login and authorization
ADMIN_EMAIL=admin@example.com

# Business Details (REQUIRED for PDF Generation)
# These details appear on all generated invoices
# Fill in with your actual business information
NEXT_PUBLIC_BUSINESS_NAME="KQ Collective"
NEXT_PUBLIC_BUSINESS_ABN="00 000 000 000"
NEXT_PUBLIC_BUSINESS_NDIS_REGISTRATION="12345678"
NEXT_PUBLIC_BUSINESS_EMAIL="contact@kqcollective.com.au"
NEXT_PUBLIC_BUSINESS_PHONE="0400 000 000"
NEXT_PUBLIC_BUSINESS_ADDRESS="Australia"
# Payment Terms (REQUIRED for PDF Generation)
# Default payment terms that appear on invoices
# Format: "14 days", "30 days", "Due on receipt", etc.
NEXT_PUBLIC_PAYMENT_TERMS="14 days"
# Bank Details (OPTIONAL)
# Leave empty if you don't want bank details shown on invoices
# These details appear in the payment information section of invoices
NEXT_PUBLIC_BUSINESS_BANK_NAME=""
NEXT_PUBLIC_BUSINESS_BSB=""
NEXT_PUBLIC_BUSINESS_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BUSINESS_ACCOUNT_NAME=""

# Travel Rate (OPTIONAL)
# Per-kilometer rate for provider travel charges on invoices
# Default: 0.97 (NDIS rate)
NEXT_PUBLIC_TRAVEL_RATE="0.97"

# Resend (Optional - for invoice email sending)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=invoices@yourdomain.com
