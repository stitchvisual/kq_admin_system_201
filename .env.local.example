# ============================================================================
# KQ Portal - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ============================================================================
# DATABASE (Required)
# ============================================================================
# Supabase Transaction pooler (port 6543) for Vercel serverless
# Dashboard: Project Settings → Database → Connection string → Pooler
DATABASE_URL="postgresql://user:password@pooler.supabase.com:6543/postgres"

# ============================================================================
# SUPABASE (Required)
# ============================================================================
# Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ============================================================================
# AUTHENTICATION (Required)
# ============================================================================
# Email address that will have admin access
ADMIN_EMAIL="admin@example.com"

# ============================================================================
# SENTRY (Required for Production)
# ============================================================================
# Dashboard: Project Settings → Client Keys
SENTRY_DSN="https://key@o1234.ingest.sentry.io/12345"
NEXT_PUBLIC_SENTRY_DSN="https://key@o1234.ingest.sentry.io/12345"
SENTRY_ENVIRONMENT="development"

# ============================================================================
# EMAIL - Resend (Optional)
# ============================================================================
# Only needed for invoice email sending
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="invoices@yourdomain.com"

# ============================================================================
# BUSINESS DETAILS (For PDF Invoices)
# ============================================================================
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"
NEXT_PUBLIC_BUSINESS_ABN="00 000 000 000"
NEXT_PUBLIC_BUSINESS_EMAIL="contact@yourbusiness.com.au"
NEXT_PUBLIC_BUSINESS_ADDRESS="Your Address"
NEXT_PUBLIC_NDIS_REGISTRATION_NUMBER="12345678"

# Bank details for invoice payment section
NEXT_PUBLIC_BUSINESS_BANK_NAME=""
NEXT_PUBLIC_BUSINESS_BSB=""
NEXT_PUBLIC_BUSINESS_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BUSINESS_ACCOUNT_NAME=""

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_TRAVEL_RATE="0.97"